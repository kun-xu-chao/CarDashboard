# ==========================================
# Qt / C++ 项目标准 .gitignore 配置
# ==========================================

# 1. 编译产物（最重要，绝对不能传上去）
build/
build-*/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# 2. Qt 自动生成的文件
*.pro.user
*.pro.user.*
.qmake.stash
*.qmlc
*.jsc
Makefile
Makefile.*

# 3. CMake 生成的文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# 4. IDE 与编辑器配置（每个人电脑上的个人配置不同，不需要传）
.vscode/
.idea/
.workbuddy/
*.swp

# 5. 操作系统产生的临时文件
.DS_Store
Thumbs.db
desktop.ini